<Window x:Class="VRCOverlay.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VRC Overlay"
        Height="250" Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#E6000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Others' Speech -->
        <StackPanel Grid.Column="0" Margin="12,8">
            <TextBlock Text="Others" FontSize="10" Foreground="#FF81C784" Margin="0,0,0,4"/>
            <TextBlock x:Name="IncomingOriginal" FontSize="12" Foreground="#88FFFFFF"
                       TextWrapping="Wrap" Margin="0,0,0,2"/>
            <TextBlock x:Name="IncomingTranslated" FontSize="16" Foreground="White"
                       FontWeight="Medium" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Divider -->
        <Rectangle Grid.Column="1" Fill="#22FFFFFF"/>

        <!-- Right Panel: My Speech -->
        <StackPanel Grid.Column="2" Margin="12,8">
            <TextBlock Text="Me" FontSize="10" Foreground="#FF4FC3F7" Margin="0,0,0,4"/>
            <TextBlock x:Name="OutgoingOriginal" FontSize="12" Foreground="#88FFFFFF"
                       TextWrapping="Wrap" Margin="0,0,0,2"/>
            <TextBlock x:Name="OutgoingTranslated" FontSize="16" Foreground="White"
                       FontWeight="Medium" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Settings button (top-right) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
            <TextBlock x:Name="StatusText" FontSize="9" Foreground="#44FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="BtnSettings" Content="⚙" Width="24" Height="24"
                    FontSize="12" Background="#33FFFFFF" Foreground="White" BorderThickness="0"
                    Click="BtnSettings_Click"/>
        </StackPanel>
    </Grid>
</Window>
