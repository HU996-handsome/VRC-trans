# VRC-Translator API Keys
# Copy this file to .env and fill in your keys

# Required for DashScope ASR and Translation
DASHSCOPE_API_KEY=

# Optional: DeepL translation
DEEPL_API_KEY=

# Optional: OpenRouter LLM translation
OPENROUTER_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-2.5-flash

# Optional: Soniox multi-language ASR
SONIOX_API_KEY=
